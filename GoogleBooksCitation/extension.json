{
	"name": "GoogleBooksCitation",
	"version": "1.0.0",
	"author": "LegalizeAdulthood",
	"url": "https://github.com/LegalizeAdulthood/google-books-citation",
	"descriptionmsg": "googlebooks-citation-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "parserhook",
	"requires": {
		"MediaWiki": ">= 1.31.0"
	},
	"AutoloadClasses": {
		"GoogleBooksCitationHooks": "includes/GoogleBooksCitationHooks.php",
		"GoogleBooksCitationParser": "includes/GoogleBooksCitationParser.php",
		"ApiGoogleBooksCitation": "includes/ApiGoogleBooksCitation.php"
	},
	"APIModules": {
		"googlebooks-citation": "ApiGoogleBooksCitation"
	},
	"Hooks": {
		"ParserFirstCallInit": "GoogleBooksCitationHooks::onParserFirstCallInit",
		"BeforePageDisplay": "GoogleBooksCitationHooks::onBeforePageDisplay"
	},
	"MessagesDirs": {
		"GoogleBooksCitation": [
			"i18n"
		]
	},
	"ResourceModules": {
		"ext.googleBooksCitation.toolbar": {
			"scripts": [
				"resources/ext.googleBooksCitation.toolbar.js"
			],
			"dependencies": [
				"mediawiki.api",
				"jquery.textSelection"
			],
			"messages": [
				"googlebooks-citation-toolbar-button",
				"googlebooks-citation-toolbar-prompt",
				"googlebooks-citation-error-fetch"
			]
		}
	},
	"manifest_version": 1
}
